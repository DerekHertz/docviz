---
title: "One card and its money"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks SpendShows
    lg1: Breaks BudgetFirst or SpendShows in some cases
    lg2: Path to the BudgetFirst or SpendShows bug
  }
  class lg0 breaks
  class lg1 mayBreak
  class lg2 bugPath
  s0: not drawn yet
  s1: drawing
  s2: failed
  s3: on the page
  s4: dismissed
  s5: redrawing
  s6: dismissed, call still out
  s7: on the page, budget used up
  [*] --> s0
  s0 --> s1: you break down the page
  s1 --> s2: the call fails after spending or the call times out
  s1 --> s3: the card comes back
  s2 --> s4: you dismiss it
  s2 --> s5: you press Retry
  s3 --> s4: you dismiss it
  s3 --> s5: you press Simpler
  s5 --> s6: you dismiss it
  s5 --> s7: the call fails after spending or the card comes back or the call times out
  s6 --> s4: the call comes back to no card
  s7 --> s4: you dismiss it
  s7 --> s5: you press Simpler
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 bugPath
  class s2 mayBreak
  class s2 bugPath
  class s3 breaks
  class s3 bugPath
  class s4 mayBreak
  class s5 mayBreak
  class s5 bugPath
  class s6 mayBreak
  class s7 mayBreak
  class s7 bugPath
